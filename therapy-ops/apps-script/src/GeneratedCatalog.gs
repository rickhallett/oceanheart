var THERAPY_OPS_CATALOG = JSON.parse("{\"generatedSchemaVersion\":1,\"service\":{\"schemaVersion\":1,\"serviceId\":\"oceanheart-private-therapy\",\"serviceName\":\"Oceanheart Private Therapy\",\"copyVersion\":\"v0.1.0\",\"copyStatus\":\"DRAFT_FOR_REVIEW\",\"operationalStatus\":\"NOT_APPROVED_FOR_REAL_CLIENT_USE\",\"scope\":{\"minimumAge\":18,\"clientLocation\":\"United Kingdom\",\"format\":\"remote-individual\",\"sessionPlatform\":\"Google Meet\",\"excludedFromMvp\":[\"clients under 18\",\"couples or group therapy\",\"clients outside the United Kingdom\",\"emergency or crisis response\",\"audio or video recording\",\"solely automated clinical decisions\"]},\"commercial\":{\"sessionsPerBlock\":4,\"paymentTiming\":\"in-advance\",\"cancellationNoticeHours\":48,\"sessionFee\":\"[SESSION_FEE]\",\"sessionLengthMinutes\":\"[SESSION_LENGTH_MINUTES]\",\"blockExpiry\":\"[BLOCK_EXPIRY]\",\"paymentMethod\":\"[PAYMENT_METHOD]\",\"coolingOffTreatment\":\"[REVIEW_AND_CONFIRM_CONSUMER_CANCELLATION_TERMS]\"},\"practice\":{\"practitionerName\":\"Richard Hallett\",\"practitionerRole\":\"[PROFESSIONAL_TITLE]\",\"practiceLegalName\":\"[PRACTICE_LEGAL_NAME]\",\"dataControllerLegalName\":\"[DATA_CONTROLLER_LEGAL_NAME]\",\"contactEmail\":\"kai@oceanheart.ai\",\"businessAddress\":\"[BUSINESS_CONTACT_ADDRESS]\",\"professionalBody\":\"[PROFESSIONAL_BODY]\",\"membershipNumber\":\"[MEMBERSHIP_NUMBER]\",\"supervisorArrangement\":\"[SUPERVISION_ARRANGEMENT]\",\"insurer\":\"[INSURER_NAME]\",\"insurancePolicyNumber\":\"[POLICY_NUMBER]\",\"complaintsRoute\":\"[COMPLAINTS_ROUTE]\"},\"dataProtection\":{\"article6Basis\":\"[ARTICLE_6_BASIS]\",\"article9Condition\":\"[ARTICLE_9_CONDITION]\",\"administrativeRetention\":\"[ADMIN_RETENTION_PERIOD]\",\"clinicalRetention\":\"[CLINICAL_RETENTION_PERIOD]\",\"transcriptRetention\":\"[TRANSCRIPT_RETENTION_PERIOD]\",\"approvedAiProcessors\":[\"[APPROVED_AI_PROCESSOR_AND_PRODUCT]\"],\"servicePathIfCaptureDeclined\":\"[SERVICE_PATH_IF_TRANSCRIPTION_OR_AI_DECLINED]\",\"icoRegistrationNumber\":\"[ICO_REGISTRATION_NUMBER]\"},\"workspace\":{\"rootFolderName\":\"Private Therapy Operations\",\"clientFolderPrefix\":\"Client\",\"calendarTitlePrefix\":\"Private session\",\"formsRequireGoogleAccount\":false,\"collectCardDetails\":false,\"automaticallyStartTranscription\":false,\"automaticallyShareClinicalRecords\":false}},\"copy\":{\"manifest\":{\"version\":\"v0.1.0\",\"status\":\"DRAFT_FOR_REVIEW\",\"effectiveDate\":\"[EFFECTIVE_DATE_AFTER_APPROVAL]\",\"documents\":[{\"id\":\"how-we-work\",\"file\":\"01-how-we-work.md\",\"audience\":\"client\",\"requiresSignature\":false},{\"id\":\"therapy-agreement\",\"file\":\"02-therapy-agreement.md\",\"audience\":\"client\",\"requiresSignature\":true},{\"id\":\"privacy-notice\",\"file\":\"03-privacy-notice.md\",\"audience\":\"client\",\"requiresSignature\":false,\"requiresAcknowledgement\":true},{\"id\":\"transcription-ai-schedule\",\"file\":\"04-transcription-and-ai-processing.md\",\"audience\":\"client\",\"requiresSignature\":true},{\"id\":\"remote-session-checklist\",\"file\":\"05-remote-session-checklist.md\",\"audience\":\"client\",\"requiresSignature\":false,\"requiresAcknowledgement\":true}]},\"documents\":[{\"id\":\"how-we-work\",\"file\":\"01-how-we-work.md\",\"audience\":\"client\",\"requiresSignature\":false,\"content\":\"# How we will work together\\n\\nStatus: Draft for review\\n\\nVersion: v0.1.0\\n\\nThis short guide explains the practical shape of the service. The therapy\\nagreement, privacy notice, and transcription and AI-processing schedule provide\\nthe full terms.\\n\\n## The service\\n\\nSessions are held remotely through Google Meet and normally last\\n{{sessionLengthMinutes}} minutes. We begin with a block of\\n{{sessionsPerBlock}} sessions, paid in advance. The block gives us enough time\\nto establish a shared understanding, agree useful goals, and review whether the\\nwork is helping.\\n\\nTherapy is collaborative. Alongside our conversations, we may use a shared\\nGoogle document or slide deck as a working map. It can hold agreed goals,\\ndiagrams, exercises, explanations, and other material that you may want to keep.\\nThis client-visible workspace is separate from my private clinical record.\\n\\n## Technology\\n\\nPlease join from a private place using a laptop or desktop computer with a\\nwebcam where possible. A larger screen makes it easier to work together on the\\nshared workspace. If this creates an accessibility or practical difficulty,\\nplease tell me so we can agree an alternative.\\n\\nAt the start of remote sessions I may confirm:\\n\\n- your current location;\\n- that you can speak privately;\\n- the best telephone number to use if the connection fails;\\n- whether the agreed transcription or AI-processing settings still apply.\\n\\n## Transcription and AI-supported work\\n\\nGoogle Meet transcription and approved private AI tools may be used only under\\nthe separate transcription and AI-processing schedule. These tools support my\\nwork. They do not replace my clinical judgement, and they do not make\\nindependent decisions about diagnosis, treatment, risk, or confidentiality.\\n\\n## Payment and cancellations\\n\\nThe fee is {{sessionFee}} per session. A block contains\\n{{sessionsPerBlock}} sessions and is paid {{paymentTiming}}.\\n\\nPlease give at least {{cancellationNoticeHours}} hours' notice if you need to\\ncancel or move a session. The therapy agreement explains charges, exceptions,\\nrefunds, and what happens when I cancel.\\n\\n## Emergencies\\n\\nThis is not an emergency or crisis service. I do not provide continuous\\nmonitoring or an out-of-hours response. The therapy agreement explains the\\ncontact and risk arrangements that apply.\\n\\n## Questions\\n\\nPlease ask about anything that feels unclear, uncomfortable, or overly formal.\\nThe purpose of these documents is to make our work understandable and\\npredictable, not to prevent discussion.\\n\"},{\"id\":\"therapy-agreement\",\"file\":\"02-therapy-agreement.md\",\"audience\":\"client\",\"requiresSignature\":true,\"content\":\"# Private therapy agreement\\n\\nStatus: Draft for review\\n\\nVersion: v0.1.0\\n\\nThis agreement is between:\\n\\n- Practitioner: {{practitionerName}}, {{practitionerRole}}\\n- Practice: {{practiceLegalName}}\\n- Client: {{clientFullName}}\\n- Agreement date: {{agreementDate}}\\n\\n## 1. Purpose and scope\\n\\nWe are agreeing to remote individual therapy for an adult client located in the\\nUnited Kingdom. Therapy involves uncertainty. I will work carefully and\\ncollaboratively, but I cannot guarantee a particular result.\\n\\nThis service is not suitable for emergency or crisis response. It is not a\\nreplacement for urgent medical care, emergency services, or continuous risk\\nmonitoring.\\n\\n## 2. Sessions\\n\\nSessions are normally {{sessionLengthMinutes}} minutes and are held through\\nGoogle Meet. We will agree session dates together.\\n\\nThe client agrees, where reasonably possible, to join:\\n\\n- from a private and safe place;\\n- using a laptop or desktop computer with a webcam;\\n- with access to the shared collaboration workspace;\\n- from a location that can be identified if urgent help is required.\\n\\nIf technology fails, I may contact the client using the agreed telephone number.\\nWe will decide whether to continue by telephone, rearrange, or end the session.\\n\\n## 3. Fees and blocks\\n\\nThe fee is {{sessionFee}} per session. Sessions are purchased in blocks of\\n{{sessionsPerBlock}} and paid {{paymentTiming}} by {{paymentMethod}}.\\n\\nThe block-expiry rule is: {{blockExpiry}}.\\n\\nNo card details will be collected through the intake form or stored in the\\nclinical record.\\n\\n## 4. Cancellations and missed sessions\\n\\nThe client should provide at least {{cancellationNoticeHours}} hours' notice to\\ncancel or rearrange a session.\\n\\nDraft rule for review:\\n\\n- With sufficient notice, the session can be rearranged without charge.\\n- With less notice, the session may be treated as used when the reserved time\\n  cannot reasonably be filled.\\n- Reasonable discretion may be used for emergencies, serious illness, or other\\n  exceptional circumstances.\\n- If I cancel, the session will be rearranged or refunded and will not be\\n  counted as used.\\n\\nConsumer cancellation and cooling-off treatment:\\n{{coolingOffTreatment}}.\\n\\n## 5. Confidentiality\\n\\nI will treat the work as confidential and will explain who may have access to\\nthe records. Total confidentiality cannot be guaranteed.\\n\\nInformation may need to be discussed or disclosed:\\n\\n- in professional supervision, using the minimum identifying information\\n  reasonably necessary;\\n- when I believe there is a serious risk of harm to the client or another\\n  person;\\n- for safeguarding purposes;\\n- when disclosure is required by law or a court;\\n- when another professional or emergency service needs information to protect\\n  health or safety;\\n- when the client asks me to communicate with another person or organisation.\\n\\nWhere it is safe and lawful to do so, I will try to discuss a disclosure with\\nthe client first.\\n\\n## 6. Records, transcription, and AI processing\\n\\nThe privacy notice explains the records I keep, the purposes for which they are\\nused, who can access them, and how long they are retained.\\n\\nGoogle Meet transcription and AI-supported processing are governed by a\\nseparate schedule. Audio or video recording is outside this MVP and requires a\\nseparate future agreement.\\n\\nAI-generated material is treated as a draft. I remain responsible for checking\\nclinical notes, formulations, treatment plans, evaluations, reports, letters,\\nand other professional output.\\n\\n## 7. Collaborative workspace\\n\\nWe may maintain a client-visible Google document or slide deck. It is intended\\nto support shared understanding and provide useful material for the client to\\nkeep.\\n\\nThe shared workspace is not the complete clinical record. Private notes,\\ntranscripts, supervision material, risk records, and provisional professional\\nthinking will not be shared into it automatically.\\n\\n## 8. Communication and availability\\n\\nRoutine contact should use {{contactEmail}} unless we agree another method.\\n\\nExpected response time: {{routineResponseTime}}.\\n\\nI do not provide continuous messaging, monitoring, or an out-of-hours crisis\\nservice.\\n\\n## 9. Ending therapy\\n\\nEither person may propose ending therapy. Where possible, we will use a session\\nto review the work, consider next steps, and close the shared materials.\\n\\nThe agreement must state what happens to unused prepaid sessions:\\n{{unusedSessionTreatment}}.\\n\\nI may pause or end the service if it falls outside my competence, becomes\\nunsafe, is no longer clinically appropriate, invoices remain unpaid, or the\\nagreement is repeatedly not followed. Except where immediate action is\\nnecessary, I will explain the concern and discuss alternatives or referrals.\\n\\n## 10. Professional information and complaints\\n\\nProfessional body: {{professionalBody}}\\n\\nMembership number: {{membershipNumber}}\\n\\nSupervision arrangement: {{supervisorArrangement}}\\n\\nProfessional indemnity insurer: {{insurer}}\\n\\nPolicy number: {{insurancePolicyNumber}}\\n\\nComplaints route: {{complaintsRoute}}\\n\\n## 11. Agreement\\n\\nBy signing, both people confirm that they have discussed the service, had an\\nopportunity to ask questions, and agree to these terms and the referenced\\ndocuments.\\n\\nClient signature: {{clientSignature}}\\n\\nDate: {{clientSignatureDate}}\\n\\nPractitioner signature: {{practitionerSignature}}\\n\\nDate: {{practitionerSignatureDate}}\\n\"},{\"id\":\"privacy-notice\",\"file\":\"03-privacy-notice.md\",\"audience\":\"client\",\"requiresSignature\":false,\"requiresAcknowledgement\":true,\"content\":\"# Privacy notice for private therapy\\n\\nStatus: Draft for review\\n\\nVersion: v0.1.0\\n\\nThis notice explains how personal information is used in the private therapy\\nservice. It is information for the client, not a request for a blanket waiver of\\nprivacy rights.\\n\\n## Who is responsible\\n\\nData controller: {{dataControllerLegalName}}\\n\\nContact email: {{contactEmail}}\\n\\nContact address: {{businessAddress}}\\n\\nICO registration number: {{icoRegistrationNumber}}\\n\\n## Information collected\\n\\nDepending on what is necessary for the service, records may include:\\n\\n- name, date of birth, address, email address, and telephone number;\\n- GP and emergency-contact details;\\n- appointment, invoice, payment-status, and communication records;\\n- intake information and relevant health information;\\n- clinical notes, risk and safeguarding records, goals, formulations, plans,\\n  outcome reviews, reports, and letters;\\n- Google Meet transcripts where separately agreed;\\n- material created in the client-visible collaboration workspace;\\n- records showing which agreements and consent settings applied.\\n\\nPayment-card details are not collected or stored.\\n\\n## Purposes\\n\\nInformation may be used to:\\n\\n- assess whether the service is suitable;\\n- arrange, provide, review, and close therapy;\\n- manage risk, safeguarding, and continuity of care;\\n- communicate with the client and, when authorised or otherwise justified,\\n  relevant professionals or emergency contacts;\\n- manage appointments, invoices, payments, complaints, and insurance matters;\\n- prepare and review provisional formulations, treatment plans, progress\\n  evaluations, reports, and letters;\\n- meet professional, legal, insurance, and record-keeping responsibilities.\\n\\nInformation will not be used for advertising, public case studies, or training\\ngeneral-purpose AI models without a new and specific agreement.\\n\\n## Lawful basis\\n\\nThe proposed Article 6 lawful basis is:\\n{{article6Basis}}.\\n\\nThe proposed Article 9 special-category condition is:\\n{{article9Condition}}.\\n\\nThese entries require professional data-protection review before operational\\nuse.\\n\\n## Google Workspace and approved processors\\n\\nThe primary record system is the Oceanheart Google Workspace account. Google\\nDrive, Docs, Sheets, Forms, Calendar, Meet, Gmail, and eligible Workspace\\ngovernance features may process service information.\\n\\nApproved AI processors and products:\\n{{approvedAiProcessors}}.\\n\\nFor each processor, the practice will maintain a record of the purpose,\\ncontractual protections, retention settings, location or transfer mechanism,\\naccess controls, model-training policy, and deletion route.\\n\\n## Access and sharing\\n\\nAccess is limited to people who need the information for an agreed purpose.\\nThis may include:\\n\\n- the practitioner;\\n- the practitioner's professional supervisor;\\n- approved technology processors;\\n- another professional, emergency contact, safeguarding body, insurer, legal\\n  adviser, court, or emergency service where the client has authorised sharing\\n  or another lawful justification applies.\\n\\nAdministrative, clinical, and client-visible records are kept separate.\\nContact details should be kept separately from private session notes where\\npracticable.\\n\\n## Retention\\n\\nProposed administrative retention period:\\n{{administrativeRetention}}.\\n\\nProposed clinical retention period:\\n{{clinicalRetention}}.\\n\\nProposed transcript retention period:\\n{{transcriptRetention}}.\\n\\nRetention periods require confirmation against professional, insurance, legal,\\nand clinical requirements. Reaching a retention date creates a review task. It\\ndoes not cause automatic deletion without checking for an active complaint,\\nlegal hold, safeguarding need, insurance matter, or other justified exception.\\n\\n## Accuracy and AI-supported drafts\\n\\nAutomated transcripts and AI-generated drafts can be incomplete or wrong. The\\npractitioner reviews material before relying on it professionally. Clients are\\nencouraged to raise misunderstandings or factual errors.\\n\\nNo solely automated system decides diagnosis, treatment, risk, disclosure,\\neligibility, or termination of therapy.\\n\\n## Client rights\\n\\nSubject to applicable law, clients may ask for:\\n\\n- access to their personal information;\\n- correction of inaccurate information;\\n- restriction or objection to some processing;\\n- deletion where there is no overriding reason to retain information;\\n- transfer of information in an appropriate format;\\n- information about how a decision or record was produced.\\n\\nWithdrawing an optional consent affects future processing. It does not\\nautomatically require deletion of information that must be retained for another\\nlawful and explained reason.\\n\\nQuestions or requests should be sent to {{contactEmail}}.\\n\\nClients may also complain to the Information Commissioner's Office. The\\npractice complaints route is {{complaintsRoute}}.\\n\\n## Changes\\n\\nMaterial changes will receive a new version. The record will show which privacy\\nnotice and consent schedule applied to each client.\\n\"},{\"id\":\"transcription-ai-schedule\",\"file\":\"04-transcription-and-ai-processing.md\",\"audience\":\"client\",\"requiresSignature\":true,\"content\":\"# Transcription and AI-processing schedule\\n\\nStatus: Draft for review\\n\\nVersion: v0.1.0\\n\\nThis schedule is separate from the therapy agreement so that capture and\\nAI-processing choices are clear and reviewable.\\n\\n## 1. What is proposed\\n\\nThe proposed service may use:\\n\\n- Google Meet transcription to create a written transcript of spoken words;\\n- approved private AI tools to help the practitioner draft and review\\n  professional material;\\n- a client-visible Google document or slide deck for collaborative work.\\n\\nGoogle Meet transcription is not the same as audio or video recording. Audio\\nand video recording are outside this MVP.\\n\\n## 2. Why the tools may be used\\n\\nSubject to the choices below, transcripts and clinical records may be used to\\nsupport:\\n\\n- provisional formulation;\\n- collaborative goal setting and treatment planning;\\n- progress and outcome review;\\n- preparation and checking of clinical notes;\\n- preparation of a client-visible summary or diagram;\\n- drafting reports and letters requested as part of the work;\\n- identifying inconsistencies, missing information, or questions for the\\n  practitioner to review.\\n\\nThe tools are intended to support the practitioner's attention and follow-up.\\nThey do not guarantee faster treatment or better outcomes.\\n\\n## 3. Safeguards\\n\\n- The practitioner remains responsible for all clinical decisions.\\n- AI output is a draft until reviewed by the practitioner.\\n- No AI tool may make a solely automated decision about diagnosis, treatment,\\n  risk, confidentiality, disclosure, or ending therapy.\\n- Only approved processors and products listed in the privacy notice may be\\n  used.\\n- Material must not be used to train a general-purpose model unless a new,\\n  specific agreement is made.\\n- Client-identifying information should be minimised when the approved purpose\\n  does not require it.\\n- Internal records are not added to the client-visible workspace\\n  automatically.\\n\\n## 4. Per-session control\\n\\nThe practitioner will not configure transcription to start automatically.\\n\\nAt the beginning of a session the practitioner will check whether the agreed\\ncapture setting still applies. Google Meet also shows participants when\\ntranscription is active.\\n\\nTranscription can be stopped and restarted. If either person asks to stop, the\\npractitioner will stop it as soon as reasonably possible. An off-record section\\nwill not be copied into later notes from memory as if it had been transcribed.\\n\\n## 5. Choices\\n\\nPlease record each choice separately.\\n\\n### A. Google Meet transcription\\n\\n- [ ] I agree to Google Meet transcription of future sessions, subject to a\\n  check at each session.\\n- [ ] I do not agree to Google Meet transcription.\\n- [ ] I want to discuss this before deciding.\\n\\n### B. AI-supported clinical drafting\\n\\n- [ ] I agree to approved AI tools processing agreed records for provisional\\n  formulation and treatment planning.\\n- [ ] I agree to approved AI tools processing agreed records for progress and\\n  outcome review.\\n- [ ] I agree to approved AI tools processing agreed records for drafting\\n  reports or letters that the practitioner will review.\\n- [ ] I agree to approved AI tools processing agreed records for preparing\\n  client-visible summaries, diagrams, or exercises.\\n- [ ] I do not agree to AI-supported processing of my clinical records.\\n- [ ] I want to discuss this before deciding.\\n\\n### C. Audio or video recording\\n\\n- [ ] I understand that audio and video recording are not included in this MVP\\n  and will not occur under this schedule.\\n\\n## 6. If transcription or AI processing is declined\\n\\nThe service path is:\\n{{servicePathIfCaptureDeclined}}.\\n\\nThis must be completed before operational use so the client can understand the\\npractical consequence of each choice.\\n\\n## 7. Withdrawal and changes\\n\\nThe client can ask to change an optional choice for future sessions or future\\nprocessing. The practitioner will record the new version and effective date.\\n\\nWithdrawal does not automatically remove material that must be retained under\\nanother lawful and explained basis. The practitioner will explain what can be\\ndeleted, what must be retained, and why.\\n\\n## 8. Agreement\\n\\nClient name: {{clientFullName}}\\n\\nSelected choices recorded by: {{consentRecordedBy}}\\n\\nClient signature: {{clientSignature}}\\n\\nDate: {{clientSignatureDate}}\\n\\nPractitioner signature: {{practitionerSignature}}\\n\\nDate: {{practitionerSignatureDate}}\\n\"},{\"id\":\"remote-session-checklist\",\"file\":\"05-remote-session-checklist.md\",\"audience\":\"client\",\"requiresSignature\":false,\"requiresAcknowledgement\":true,\"content\":\"# Remote-session checklist\\n\\nStatus: Draft for review\\n\\nVersion: v0.1.0\\n\\n## Before the first session\\n\\n- Use a laptop or desktop computer with a webcam where possible.\\n- Check that Google Meet opens in a supported browser.\\n- Find a private place where you are unlikely to be overheard or interrupted.\\n- Keep a telephone available in case the connection fails.\\n- Confirm the telephone number, GP details, and emergency contact supplied at\\n  intake remain accurate.\\n- Open the client-visible collaboration workspace.\\n- Tell the practitioner about accessibility needs or technical barriers.\\n\\n## At the beginning of each session\\n\\nThe practitioner may confirm:\\n\\n- the client's current physical location;\\n- whether the client can speak privately;\\n- the fallback telephone number;\\n- whether anyone else is present;\\n- whether transcription or AI-processing choices have changed;\\n- whether the client can access the shared workspace.\\n\\n## If the connection fails\\n\\n1. Try to rejoin the same Google Meet.\\n2. The practitioner may call the agreed fallback number.\\n3. Decide together whether to continue by telephone or rearrange.\\n4. If there is an immediate safety concern and contact cannot be restored, the\\n   practitioner may use the agreed location, GP, or emergency-contact\\n   information in line with the therapy agreement.\\n\\n## Shared workspace\\n\\nThe shared document or slide deck is for agreed collaborative material. It is\\nnot a place for urgent messages and it is not the full clinical record.\\n\\nDo not add information about another identifiable person unless it is necessary\\nfor the therapeutic work.\\n\\n## Emergencies\\n\\nThe therapy service does not provide continuous monitoring or an out-of-hours\\ncrisis response. Emergency and urgent-care instructions will be confirmed\\nbefore operational use.\\n\"}]},\"forms\":{\"intake\":{\"schemaVersion\":1,\"id\":\"private-therapy-intake\",\"version\":\"v0.1.0\",\"status\":\"DRAFT_FOR_REVIEW\",\"title\":\"Private therapy intake\",\"description\":\"Please provide the minimum information needed to arrange and safely begin remote therapy. Do not use this form for an emergency.\",\"settings\":{\"collectEmail\":false,\"limitToOneResponse\":false,\"allowResponseEdits\":false,\"showResponseSummary\":false,\"sendResponseCopy\":\"on-request\",\"requiresGoogleAccount\":false,\"acceptingResponses\":true},\"sections\":[{\"id\":\"identity\",\"title\":\"About you\",\"items\":[{\"id\":\"invitationCode\",\"type\":\"text\",\"label\":\"Invitation code\",\"helpText\":\"This should already be filled in from the private link you received.\",\"required\":true},{\"id\":\"fullName\",\"type\":\"text\",\"label\":\"Full name\",\"required\":true},{\"id\":\"preferredName\",\"type\":\"text\",\"label\":\"Name you would like me to use\",\"required\":false},{\"id\":\"dateOfBirth\",\"type\":\"date\",\"label\":\"Date of birth\",\"required\":true},{\"id\":\"pronouns\",\"type\":\"text\",\"label\":\"Pronouns, if you would like to share them\",\"required\":false}]},{\"id\":\"contact\",\"title\":\"Contact details\",\"items\":[{\"id\":\"email\",\"type\":\"email\",\"label\":\"Email address\",\"required\":true},{\"id\":\"phone\",\"type\":\"phone\",\"label\":\"Telephone number\",\"required\":true},{\"id\":\"address\",\"type\":\"paragraph\",\"label\":\"Home address\",\"required\":true},{\"id\":\"safeContactMethod\",\"type\":\"multiple-choice\",\"label\":\"Which contact method is safe for routine messages?\",\"required\":true,\"options\":[\"Email\",\"Telephone call\",\"Text message\"]},{\"id\":\"contactRestrictions\",\"type\":\"paragraph\",\"label\":\"Is there anything I should know about when or how it is safe to contact you?\",\"required\":false}]},{\"id\":\"gp-emergency\",\"title\":\"GP and emergency contact\",\"items\":[{\"id\":\"gpName\",\"type\":\"text\",\"label\":\"GP name, if known\",\"required\":false},{\"id\":\"gpPractice\",\"type\":\"text\",\"label\":\"GP practice\",\"required\":true},{\"id\":\"gpPhone\",\"type\":\"phone\",\"label\":\"GP practice telephone number\",\"required\":true},{\"id\":\"emergencyContactName\",\"type\":\"text\",\"label\":\"Emergency contact name\",\"required\":true},{\"id\":\"emergencyContactRelationship\",\"type\":\"text\",\"label\":\"Relationship to you\",\"required\":true},{\"id\":\"emergencyContactPhone\",\"type\":\"phone\",\"label\":\"Emergency contact telephone number\",\"required\":true}]},{\"id\":\"remote-suitability\",\"title\":\"Remote-session practicalities\",\"items\":[{\"id\":\"ukBased\",\"type\":\"multiple-choice\",\"label\":\"Will you normally be physically located in the United Kingdom during sessions?\",\"required\":true,\"options\":[\"Yes\",\"No\",\"I am not sure\"]},{\"id\":\"privateSpace\",\"type\":\"multiple-choice\",\"label\":\"Can you normally join from a private place where you will not be overheard?\",\"required\":true,\"options\":[\"Yes\",\"No\",\"Sometimes\"]},{\"id\":\"deviceAccess\",\"type\":\"checkboxes\",\"label\":\"Which devices can you use for sessions?\",\"required\":true,\"options\":[\"Laptop or desktop with webcam\",\"Tablet\",\"Telephone\",\"I need to discuss an alternative\"]},{\"id\":\"accessibilityNeeds\",\"type\":\"paragraph\",\"label\":\"Please describe any accessibility, communication, or technology needs you would like me to consider.\",\"required\":false}]},{\"id\":\"clinical-overview\",\"title\":\"A brief starting point\",\"items\":[{\"id\":\"reasonForSeekingTherapy\",\"type\":\"paragraph\",\"label\":\"What would you most like help with at the moment?\",\"required\":true},{\"id\":\"hopesForTherapy\",\"type\":\"paragraph\",\"label\":\"What would tell you that therapy was useful?\",\"required\":false},{\"id\":\"currentSupport\",\"type\":\"paragraph\",\"label\":\"Are you currently receiving relevant support, treatment, or medication that would be helpful for me to know about?\",\"required\":false},{\"id\":\"immediateSafetyConcern\",\"type\":\"multiple-choice\",\"label\":\"Is there an immediate concern about your safety or someone else's safety that requires urgent support?\",\"required\":true,\"options\":[\"No\",\"Yes\",\"I am not sure\"],\"reviewRule\":\"Any answer other than No blocks automatic progression and requires practitioner review.\"}]},{\"id\":\"acknowledgements\",\"title\":\"Before submitting\",\"items\":[{\"id\":\"notEmergencyService\",\"type\":\"checkbox\",\"label\":\"I understand that this form and service are not monitored as an emergency or crisis service.\",\"required\":true},{\"id\":\"privacyNoticeAcknowledged\",\"type\":\"checkbox\",\"label\":\"I have received the draft privacy notice and understand that I can ask questions before therapy begins.\",\"required\":true},{\"id\":\"informationAccurate\",\"type\":\"checkbox\",\"label\":\"The information I have provided is accurate to the best of my knowledge.\",\"required\":true}]}]},\"sessionCaptureCheck\":{\"schemaVersion\":1,\"id\":\"session-capture-check\",\"version\":\"v0.1.0\",\"status\":\"DRAFT_FOR_REVIEW\",\"audience\":\"practitioner\",\"description\":\"A practitioner-only structured check before transcription or AI-supported processing.\",\"fields\":[{\"id\":\"clientId\",\"type\":\"client-id\",\"required\":true},{\"id\":\"sessionId\",\"type\":\"session-id\",\"required\":true},{\"id\":\"clientLocationConfirmed\",\"type\":\"boolean\",\"required\":true},{\"id\":\"privacyConfirmed\",\"type\":\"boolean\",\"required\":true},{\"id\":\"consentVersion\",\"type\":\"version\",\"required\":true},{\"id\":\"transcriptionAllowedToday\",\"type\":\"boolean\",\"required\":true},{\"id\":\"approvedAiPurposes\",\"type\":\"multi-select\",\"required\":true,\"options\":[\"provisional-formulation\",\"treatment-planning\",\"progress-review\",\"report-or-letter-drafting\",\"client-visible-material\"]},{\"id\":\"checkedBy\",\"type\":\"practitioner-identity\",\"required\":true},{\