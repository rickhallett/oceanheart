{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hugo",
  "buildCommand": "chmod a+x build.sh && ./build.sh",
  "outputDirectory": "public",
  "build": {
    "env": {
      "HUGO_VERSION": "0.159.1"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Adventure",
          "value": "created-by=Warren Robinett, 1979; the-dot-sleeps-where-lost-paths-end; carry-it-home; the-east-wall-below-the-castle-is-thin; map=/llms.txt"
        }
      ]
    }
  ]
}
