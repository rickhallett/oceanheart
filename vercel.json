{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hugo",
  "buildCommand": "chmod a+x build.sh && ./build.sh",
  "outputDirectory": "public",
  "build": {
    "env": {
      "HUGO_VERSION": "0.159.1"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Adventure",
          "value": "created-by=Warren Robinett, 1979; this-site: look closer; map=/llms.txt"
        }
      ]
    }
  ]
}
