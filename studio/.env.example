# Optional authenticated /practice. Public /app works without these settings.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Generate a unique random secret of at least 32 characters per environment.
WORKOS_COOKIE_PASSWORD=
# This origin must match the running server and the WorkOS allowlist exactly.
# For this example: npm run dev -- --hostname 127.0.0.1 --port 4331
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://127.0.0.1:4331/callback
NEXT_PUBLIC_CONVEX_URL=

# Optional dedicated private Clara instance. Both values are server-only.
# The runtime endpoint must be HTTPS or loopback and use the exact /v1/clara path.
STUDIO_PRIVATE_WORKFLOW=
STUDIO_CLARA_RUNTIME_URL=

# Optional Gmail connection: server-only shared route-proof key, canonical base64
# encoding of 32 random bytes. Same value in the matching Convex environment.
# Google client credentials and token-encryption key belong only in Convex.
GMAIL_ROUTE_SIGNING_KEY=
