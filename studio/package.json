{
  "name": "oceanheart-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "verify": "npm run build && npm run typecheck && npm run test:e2e",
    "theme:types": "chakra typegen ./src/theme.ts",
    "prebuild": "npm run theme:types"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@clerk/nextjs": "^7.9.1",
    "@emotion/react": "^11.14.0",
    "convex": "^1.45.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.37.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3"
  }
}
